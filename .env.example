# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on
PORT=4000

# --- Sign-in keys -----------------------------------------------------------
# STAFF_KEY lets people run the counters. Use a long random phrase, not a word.
STAFF_KEY=
# Optional. If set, ONLY this key can open Services, Reports and exports,
# and STAFF_KEY becomes counter-only. Leave empty to let STAFF_KEY do everything.
ADMIN_KEY=
# Hours a sign-in lasts (default 12)
# SESSION_TTL_HOURS=12

# --- Push notifications (optional) ------------------------------------------
# Generate a NEW pair with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or an https:// URL you control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Privacy ----------------------------------------------------------------
# Show customer names on the public display and kiosk lists? (default false: tokens only)
# PUBLIC_SHOW_NAMES=false
# Completed tickets (with names) are deleted after this many days. 0 = keep forever. Default 30.
# RETENTION_DAYS=30

# --- HTTPS (optional) -------------------------------------------------------
# Phones need HTTPS (or localhost) to receive push notifications.
# HTTPS_KEY_FILE=frontend/certs/your-key.pem
# HTTPS_CERT_FILE=frontend/certs/your-cert.pem

# --- Other ------------------------------------------------------------------
# Database file (default: queue.db next to server.js)
# DB_FILE=queue.db
# Limit how many tickets one device can take in a window (defaults: 30 per 300 seconds)
# TICKET_RATE_MAX=30
# TICKET_RATE_WINDOW_SECONDS=300
# Only needed if the admin panel is served from a DIFFERENT address than the server:
# CORS_ORIGINS=https://panel.example.com
# Only needed behind a reverse proxy that is not on this machine:
# TRUST_PROXY=1
