# Copy to frontend/.env.local (not committed). Only needed for `npm run dev`.

# HTTPS for the dev server, so phones on your Wi-Fi can use notifications.
# Make a certificate for your PC's LAN address with mkcert, then point to the files:
# DEV_HTTPS_KEY=certs/192.168.1.20+2-key.pem
# DEV_HTTPS_CERT=certs/192.168.1.20+2.pem

# Where the Node server is running (default http://localhost:4000)
# API_TARGET=http://localhost:4000
